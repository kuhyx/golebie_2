<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity-specific Roslyn analyzers -->
    <Analyzer Include="$(NuGetPackageRoot)microsoft.unity.analyzers/*/analyzers/dotnet/cs/Microsoft.Unity.Analyzers.dll" />

    <!-- StyleCop for naming/formatting/ordering rules -->
    <Analyzer Include="$(NuGetPackageRoot)stylecop.analyzers/*/analyzers/dotnet/cs/StyleCop.Analyzers.dll" />
    <Analyzer Include="$(NuGetPackageRoot)stylecop.analyzers/*/analyzers/dotnet/cs/StyleCop.Analyzers.CodeFixes.dll" />

    <!-- Sonar analyzer for bugs, security, code smells -->
    <Analyzer Include="$(NuGetPackageRoot)sonaranalyzer.csharp/*/analyzers/SonarAnalyzer.CSharp.dll" />
    <Analyzer Include="$(NuGetPackageRoot)sonaranalyzer.csharp/*/analyzers/SonarAnalyzer.CFG.dll" />

    <!-- Roslynator for 500+ additional rules -->
    <Analyzer Include="$(NuGetPackageRoot)roslynator.analyzers/*/analyzers/dotnet/cs/Roslynator.CSharp.Analyzers.dll" />
    <Analyzer Include="$(NuGetPackageRoot)roslynator.analyzers/*/analyzers/dotnet/cs/Roslynator.CSharp.Analyzers.CodeFixes.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.*" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.*">
      <IncludeAssets>analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.*">
      <IncludeAssets>analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.*">
      <IncludeAssets>analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
