#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook for Unity C# project
# Checks: file encoding, trailing whitespace, file endings, naming conventions

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

errors=0

echo "=== Pre-commit checks ==="

# Get staged C# files (only our code, not third-party packages or plugins)
cs_files=$(git diff --cached --name-only --diff-filter=ACM -- 'Assets/Scripts/*.cs' 'Assets/Tests/*.cs' || true)

if [[ -z "$cs_files" ]]; then
    echo -e "${GREEN}No project C# files staged. Skipping C# checks.${NC}"
    exit 0
fi

echo "Checking $(echo "$cs_files" | wc -l) C# file(s)..."

# Check 1: No tabs in C# files (we use spaces)
echo -n "  Checking for tabs... "
tabs_found=false
while IFS= read -r file; do
    if [[ -f "$file" ]] && grep -Pn '\t' "$file" > /dev/null 2>&1; then
        if [[ "$tabs_found" == false ]]; then
            echo ""
            tabs_found=true
        fi
        echo -e "${RED}    Tab characters found in: $file${NC}"
        grep -Pn '\t' "$file" | head -5
        errors=$((errors + 1))
    fi
done <<< "$cs_files"
if [[ "$tabs_found" == false ]]; then
    echo -e "${GREEN}OK${NC}"
fi

# Check 2: No trailing whitespace
echo -n "  Checking for trailing whitespace... "
trailing_found=false
while IFS= read -r file; do
    if [[ -f "$file" ]] && grep -Pn '\s+$' "$file" > /dev/null 2>&1; then
        if [[ "$trailing_found" == false ]]; then
            echo ""
            trailing_found=true
        fi
        echo -e "${RED}    Trailing whitespace in: $file${NC}"
        errors=$((errors + 1))
    fi
done <<< "$cs_files"
if [[ "$trailing_found" == false ]]; then
    echo -e "${GREEN}OK${NC}"
fi

# Check 3: Files end with newline
echo -n "  Checking for final newline... "
newline_found=false
while IFS= read -r file; do
    if [[ -f "$file" ]] && [[ -s "$file" ]]; then
        last_byte=$(tail -c 1 "$file" | xxd -p)
        if [[ "$last_byte" != "0a" ]]; then
            if [[ "$newline_found" == false ]]; then
                echo ""
                newline_found=true
            fi
            echo -e "${RED}    Missing final newline: $file${NC}"
            errors=$((errors + 1))
        fi
    fi
done <<< "$cs_files"
if [[ "$newline_found" == false ]]; then
    echo -e "${GREEN}OK${NC}"
fi

# Check 4: No BOM in files
echo -n "  Checking for BOM markers... "
bom_found=false
while IFS= read -r file; do
    if [[ -f "$file" ]]; then
        first_bytes=$(head -c 3 "$file" | xxd -p)
        if [[ "$first_bytes" == "efbbbf" ]]; then
            if [[ "$bom_found" == false ]]; then
                echo ""
                bom_found=true
            fi
            echo -e "${RED}    BOM found in: $file${NC}"
            errors=$((errors + 1))
        fi
    fi
done <<< "$cs_files"
if [[ "$bom_found" == false ]]; then
    echo -e "${GREEN}OK${NC}"
fi

# Check 5: No TODO/HACK/FIXME in committed code
echo -n "  Checking for TODO/HACK/FIXME markers... "
todo_found=false
while IFS= read -r file; do
    if [[ -f "$file" ]] && grep -Pn '//\s*(TODO|HACK|FIXME|XXX|TEMP)\b' "$file" > /dev/null 2>&1; then
        if [[ "$todo_found" == false ]]; then
            echo ""
            todo_found=true
        fi
        echo -e "${YELLOW}    TODO/HACK/FIXME found in: $file${NC}"
        grep -Pn '//\s*(TODO|HACK|FIXME|XXX|TEMP)\b' "$file" | head -3
        errors=$((errors + 1))
    fi
done <<< "$cs_files"
if [[ "$todo_found" == false ]]; then
    echo -e "${GREEN}OK${NC}"
fi

echo ""
if [[ $errors -gt 0 ]]; then
    echo -e "${RED}=== $errors issue(s) found. Fix them before committing. ===${NC}"
    exit 1
else
    echo -e "${GREEN}=== All pre-commit checks passed! ===${NC}"
    exit 0
fi
